[Unit]
Description=Automount all internal filesystem partitions
DefaultDependencies=no
After=local-fs-pre.target systemd-udev-settle.service
Before=local-fs.target
Requires=local-fs-pre.target systemd-udev-settle.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/automount-all.sh
RemainAfterExit=yes
TimeoutSec=60

[Install]
WantedBy=local-fs.target
