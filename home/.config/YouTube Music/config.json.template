{
	"window-size": {
		"width": 1920,
		"height": 1080
	},
	"window-maximized": true,
	"window-position": {
		"x": -1,
		"y": -1
	},
	"url": "https://music.youtube.com",
	"options": {
		"tray": true,
		"appVisible": true,
		"autoUpdates": true,
		"alwaysOnTop": false,
		"hideMenu": true,
		"hideMenuWarned": true,
		"startAtLogin": false,
		"disableHardwareAcceleration": false,
		"removeUpgradeButton": false,
		"restartOnConfigChanges": false,
		"trayClickPlayPause": false,
		"autoResetAppCache": false,
		"resumeOnStart": true,
		"likeButtons": "",
		"swapLikeButtonsOrder": false,
		"proxy": "",
		"startingPage": "",
		"overrideUserAgent": false,
		"usePodcastParticipantAsArtist": false,
		"themes": [
			"$DOTFILES_DIR/home/.config/YouTube Music/pear-ytm.css"
		],
		"language": "ja",
		"customWindowTitle": ""
	},
	"plugins": {
		"precise-volume": {
			"globalShortcuts": {}
		},
		"discord": {
			"enabled": true,
			"autoReconnect": true,
			"activityTimeoutEnabled": true,
			"activityTimeoutTime": 30000,
			"playOnYouTubeMusic": true,
			"hideGitHubButton": true,
			"hideDurationLeft": false,
			"statusDisplayType": 2,
			"listenAlong": true
		},
		"do-not-track": {
			"enabled": true
		},
		"album-color-theme": {
			"enabled": true,
			"ratio": 1,
			"enableSeekbar": true
		},
		"ambient-mode": {
			"enabled": true,
			"quality": 50,
			"buffer": 30,
			"interpolationTime": 500,
			"blur": 100,
			"size": 100,
			"opacity": 1,
			"fullscreen": true
		},
		"blur-nav-bar": {
			"enabled": false
		},
		"synced-lyrics": {
			"enabled": true,
			"preciseTiming": true,
			"showLyricsEvenIfInexact": false,
			"showTimeCodes": false,
			"defaultTextString": "♪",
			"lineEffect": "offset",
			"romanization": false,
			"preferredProvider": "LRCLib"
		},
		"navigation": {
			"enabled": false
		},
		"unobtrusive-player": {
			"enabled": false
		},
		"album-actions": {
			"enabled": false
		},
		"in-app-menu": {
			"enabled": false
		},
		"notifications": {
			"enabled": false,
			"unpauseNotification": false,
			"urgency": "low",
			"interactive": true,
			"toastStyle": 1,
			"refreshOnPlayPause": false,
			"trayControls": true,
			"hideButtonText": false
		}
	},
	"__internal__": {
		"migrations": {
			"version": "3.12.0"
		}
	}
}
